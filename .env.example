# Copy to .env.local and fill in. Loaded at startup by src/core/env_loader.py.
# The active LLM provider and model are chosen in config/llm_providers.yaml.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Ollama endpoint for the "ollama" provider (overrides base_url in the YAML).
OLLAMA_HOST=http://localhost:11434
# Only needed for the matching hosted providers.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
# NVIDIA NIM (provider "nvidia_nim"); NVIDIA_NIM_BASE_URL optionally overrides the YAML base_url.
NVIDIA_NIM_API_KEY=

# ── Public-record data ───────────────────────────────────────────────────────
# Probe42 company-data API. Leave empty to run on the bundled catalog data only.
PROBE42_API_KEY=

# ── Optional path overrides (defaults are inside the project folder) ─────────
# CAM_CONFIG_DIR=./config
# CAM_STORAGE_ROOT=./storage
# CAM_OUTPUT_ROOT=./output
# CAM_RUNTIME_DB_ROOT=./runtime-db
# CAM_REFERENCE_ROOT=./downloaded document
# CAM_SYNTHETIC_ROOT=./synthetic-assets
